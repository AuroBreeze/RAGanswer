RAG_DATA_DIR=./data
# 解析方写解析包的受控存储根目录，artifact_ref 相对于此
RAG_ARTIFACT_ROOT=./data/storage
# 内部接口服务身份，逗号分隔
RAG_SERVICE_TOKENS=parser-service-token-change-me

# Embedding：openai（OpenAI 兼容接口）| hash（离线联调）
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=sk-xxx

# 生成：openai | extractive（不调模型，直接返回摘录）
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=sk-xxx

RAG_CHUNK_MAX_CHARS=600
RAG_CHUNK_OVERLAP_CHARS=80
RAG_TOP_K=5
RAG_PREVIEW_URL_TEMPLATE=/api/v1/documents/{document_id}/preview
